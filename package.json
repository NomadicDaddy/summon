{
	"name": "summon",
	"version": "0.2.0",
	"description": "Open named Codex or Claude Code sessions in a fresh terminal window.",
	"type": "module",
	"bin": {
		"summon": "./src/cli.ts"
	},
	"files": [
		"src/*.ts",
		"scripts/require-bun.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"check:leak-guard": "bun ./scripts/run-bash.ts scripts/check-leak-guard.sh",
		"preinstall": "bun scripts/require-bun.ts",
		"prepare": "bun ./scripts/run-bash.ts .githooks/leak-guard-setup.sh",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test",
		"smoke:qc": "bun run typecheck && bun run lint && bun run format:check && bun test",
		"release:check": "bun run smoke:qc && bun pm pack --dry-run"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.4.2",
		"eslint": "10.10.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	},
	"engines": {
		"bun": "1.4.0"
	}
}
