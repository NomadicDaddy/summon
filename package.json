{
	"name": "summon",
	"version": "1.0.1",
	"summonStorageLayout": 1,
	"license": "FSL-1.1-ALv2",
	"description": "Open named Claude Code, Codex, Grok Build, or Kilo sessions in a shared terminal window or team workspace.",
	"type": "module",
	"bin": {
		"summon": "./src/cli.ts"
	},
	"files": [
		"gallery/*.json",
		"gallery/*.png",
		"dist/team/*",
		"src/desktop/*",
		"src/*.ts",
		"templates/AGENTS.md.template",
		"scripts/require-bun.ts",
		"scripts/installed-launch.ts",
		"scripts/install-electron.ts",
		"scripts/build-team.ts",
		"scripts/check-release-version.ts",
		"scripts/prepare-team-seal.ts",
		"scripts/generate-third-party-notices.ts",
		"scripts/migrate-checkpoints.ts",
		"scripts/backfill-diary.ts",
		"scripts/retention-path-guard.ps1",
		"scripts/retention-path-guard.cs",
		"scripts/retention-handle-io.cs",
		"scripts/scratch-expiry.ps1",
		"scripts/scratch-expiry.cs",
		"skills/*/SKILL.md",
		"skills/*/scripts/*",
		"README.md",
		"THIRD-PARTY-NOTICES.md",
		"docs/**/*.md"
	],
	"scripts": {
		"build:installer": "bun scripts/build-installer.ts",
		"check:installer": "bun scripts/check-installer.ts",
		"build:team": "bun scripts/build-team.ts",
		"check:release-version": "bun scripts/check-release-version.ts",
		"seal:team": "bun scripts/prepare-team-seal.ts",
		"prepack": "bun run build:team && bun run check:licenses",
		"check:licenses": "bun scripts/generate-third-party-notices.ts --check",
		"check:claude-mod": "bun scripts/check-claude-mod.ts",
		"check:leak-guard": "bun ./scripts/run-bash.ts scripts/check-leak-guard.sh",
		"check:max-lines": "bun scripts/check-max-lines.ts",
		"check:dead-code": "knip",
		"preinstall": "bun scripts/require-bun.ts",
		"postinstall": "bun scripts/install-electron.ts",
		"setup:hooks": "bun scripts/setup-hooks.ts",
		"setup:updater": "bun scripts/install-updater.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun scripts/test.ts",
		"smoke:qc:fast": "bun run check:release-version && bun run check:max-lines && bun run format:check && bun run typecheck && bun run lint",
		"smoke:qc": "bun run check:release-version && bun run check:max-lines && bun run format:check && bun run typecheck && bun run lint && bun run check:dead-code && bun run build:team && bun run check:licenses && bun run check:leak-guard && bun run test",
		"release:check": "bun run smoke:qc && bun pm pack --dry-run"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.4.3",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.5",
		"eslint": "10.12.0",
		"eslint-plugin-perfectionist": "5.12.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"knip": "6.41.0",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1"
	},
	"engines": {
		"bun": ">=1.4.3"
	},
	"packageManager": "bun@1.4.3",
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"electron": "44.9.1",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm": "3.1.0",
		"micromark-extension-gfm": "3.0.0",
		"node-pty": "1.1.0",
		"zod": "4.6.6"
	}
}
